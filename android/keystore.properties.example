# copie para keystore.properties (NUNCA suba o keystore.properties nem o .jks pro GitHub)
# gerar a chave (uma vez só — guarde o arquivo e as senhas para sempre, sem elas
# não dá mais pra atualizar o app na Play Store):
#   keytool -genkeypair -v -keystore myk7-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias myk7
storeFile=myk7-release.jks
storePassword=
keyAlias=myk7
keyPassword=
