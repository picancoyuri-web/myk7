{
  "appId": "br.com.ntech.myk7",
  "appName": "MyK7",
  "webDir": "web",
  "backgroundColor": "#15110E",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "scheme": "MyK7"
  },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "CapacitorCookies": { "enabled": true },
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#15110E",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#15110E",
      "overlaysWebView": false
    }
  }
}
