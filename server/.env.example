# copie este arquivo para .env (ou cadastre estas variáveis no Render)

# OBRIGATÓRIO — segredo que assina as sessões. Gere um aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# porta do servidor (o Render define sozinho)
PORT=3001

# endereço do site (usado nos links dos e-mails, na volta do Spotify e no CORS).
# Pode ter mais de um, separado por vírgula — o primeiro é o principal.
FRONTEND_ORIGIN=https://myk7.netlify.app

# onde fica o banco SQLite (padrão: ./data/cassete.db).
# No Render, aponte pra um "Persistent Disk" (ex: /var/data/cassete.db),
# senão o banco é apagado a cada deploy.
# DB_PATH=

# token do Discogs pra ficha técnica e fotos de artistas (opcional)
# crie em https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# "ouvindo agora" via Spotify (opcional). Crie um app em
# https://developer.spotify.com/dashboard e cadastre nele a Redirect URI:
#   https://SEU-BACKEND.onrender.com/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# só se a Redirect URI for diferente da padrão acima
# SPOTIFY_REDIRECT_URI=

# envio de e-mail (opcional — sem isso os links de verificação/reset
# aparecem só no log do servidor)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# quem pode moderar denúncias (GET /api/reports e POST /api/reports/:id/resolve).
# Nomes de usuário separados por vírgula. A App Store exige moderação.
ADMIN_USERNAMES=

# assinatura MyK7+ pela RevenueCat (opcional — sem isso ninguém vira premium
# sozinho, só pela moderação em POST /api/billing/grant)
# chave secreta v1 (sk_...) e o texto de "Authorization" do webhook
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
# REVENUECAT_ENTITLEMENT=premium
